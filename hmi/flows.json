    {
        "id": "05105fe453aff448",
        "type": "ui-template",
        "z": "defbbaec7d55bf59",
        "group": "90fbf60b31d884f3",
        "page": "",
        "ui": "",
        "name": "Mixer Status",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<div style=\"text-align:center; padding:15px;\">\n\n    <div style=\"font-size:18px; font-weight:bold; margin-bottom:15px;\">\n        MIXER STATUS\n    </div>\n\n    <div v-if=\"msg.payload === true\">\n        <div class=\"mixer-running\">⚙</div>\n\n        <div style=\"\n            margin-top:10px;\n            font-size:20px;\n            font-weight:bold;\n            color:#22c55e;\n        \">\n            ● RUNNING\n        </div>\n    </div>\n\n    <div v-if=\"msg.payload === false\">\n        <div class=\"mixer-stopped\">⚙</div>\n\n        <div style=\"\n            margin-top:10px;\n            font-size:20px;\n            font-weight:bold;\n            color:#ef4444;\n        \">\n            ● STOPPED\n        </div>\n    </div>\n\n</div>\n\n<style>\n.mixer-running {\n    display:inline-block;\n    font-size:70px;\n    animation: mixer-spin 1.2s linear infinite;\n}\n\n.mixer-stopped {\n    display:inline-block;\n    font-size:70px;\n    opacity:0.45;\n}\n\n@keyframes mixer-spin {\n    from { transform: rotate(0deg); }\n    to   { transform: rotate(360deg); }\n}\n</style>",
        "storeOutMessages": true,
