    {
        "id": "02aa342e8b0eb4d5",
        "type": "ui-template",
        "z": "defbbaec7d55bf59",
        "group": "90fbf60b31d884f3",
        "page": "",
        "ui": "",
        "name": "Tank level",
        "order": 2,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<div style=\"text-align:center; width:100%;\">\n\n    <div style=\"font-size:18px; font-weight:bold; margin-bottom:10px;\">\n        MIXER TANK\n    </div>\n\n    <svg width=\"180\" height=\"300\" viewBox=\"0 0 180 300\">\n\n        <!-- Fondo del tanque -->\n        <rect\n            x=\"40\"\n            y=\"20\"\n            width=\"100\"\n            height=\"220\"\n            rx=\"15\"\n            fill=\"#eeeeee\"\n        />\n\n        <!-- Líquido -->\n        <rect\n            x=\"46\"\n            :y=\"234 - ((Number(msg.payload) || 0) * 2.08)\"\n            width=\"88\"\n            :height=\"(Number(msg.payload) || 0) * 2.08\"\n            :fill=\"(Number(msg.payload) || 0) >= 90\n                ? '#ef4444'\n                : (Number(msg.payload) || 0) >= 75\n                    ? '#f59e0b'\n                    : '#42a5f5'\"\n        />\n\n        <!-- Contorno -->\n        <rect\n            x=\"40\"\n            y=\"20\"\n            width=\"100\"\n            height=\"220\"\n            rx=\"15\"\n            fill=\"none\"\n            stroke=\"#888888\"\n            stroke-width=\"6\"\n        />\n\n        <!-- Porcentaje -->\n        <text\n            x=\"90\"\n            y=\"140\"\n            text-anchor=\"middle\"\n            font-size=\"28\"\n            font-weight=\"bold\"\n            fill=\"#222222\">\n            {{ msg.payload }} %\n        </text>\n\n        <!-- Alarma -->\n        <g v-if=\"(Number(msg.payload) || 0) >= 90\">\n\n            <text\n                x=\"90\"\n                y=\"260\"\n                text-anchor=\"middle\"\n                font-size=\"14\"\n                font-weight=\"bold\"\n                fill=\"#ef4444\">\n                ⚠ HIGH LEVEL\n            </text>\n\n            <text\n                x=\"90\"\n                y=\"282\"\n                text-anchor=\"middle\"\n                font-size=\"14\"\n                font-weight=\"bold\"\n                fill=\"#ef4444\">\n                ALARM\n            </text>\n\n        </g>\n\n        <!-- Estado normal -->\n        <text\n            v-if=\"(Number(msg.payload) || 0) < 90\"\n            x=\"90\"\n            y=\"270\"\n            text-anchor=\"middle\"\n            font-size=\"15\"\n            fill=\"#333333\">\n            Tank Level\n        </text>\n\n    </svg>\n\n</div>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 680,
        "y": 240,
        "wires": [
            []
        ]
    },
