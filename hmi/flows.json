    {
        "id": "ad4b6fdce3bcf0bd",
        "type": "function",
        "z": "defbbaec7d55bf59",
        "name": "Validate Setpoint",
        "func": "let value = Number(msg.payload);\n\nif (isNaN(value)) {\n    return null;\n}\n\nif (value < 0) value = 0;\nif (value > 1300) value = 1300;\n\nmsg.payload = value;\n\nreturn msg;",
