    {
        "id": "7138dd3fef4c144a",
        "type": "ui-template",
        "z": "3bd24cf3d6d5f494",
        "group": "a7547ced0646bbeb",
        "page": "",
        "ui": "",
        "name": "mixer running",
        "order": 0,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<div style=\"text-align:center; padding:15px;\">\n\n    <div style=\"font-size:18px; font-weight:bold; margin-bottom:15px;\">\n        MIXER STATUS\n    </div>\n\n    <!-- RUNNING -->\n    <div v-if=\"msg.payload === true\">\n\n        <div class=\"mixer-running\">\n            ⚙\n        </div>\n\n        <div style=\"\n            margin-top:10px;\n            font-size:20px;\n            font-weight:bold;\n            color:#22c55e;\n        \">\n            ● RUNNING\n        </div>\n\n        <div style=\"\n            margin-top:5px;\n            font-size:13px;\n            opacity:0.7;\n        \">\n            Mixer motor active\n        </div>\n\n    </div>\n\n\n    <!-- STOPPED -->\n    <div v-else>\n\n        <div class=\"mixer-stopped\">\n            ⚙\n        </div>\n\n        <div style=\"\n            margin-top:10px;\n            font-size:20px;\n            font-weight:bold;\n            color:#ef4444;\n        \">\n            ● STOPPED\n        </div>\n\n        <div style=\"\n            margin-top:15px;\n            padding:10px;\n            border:2px solid #ef4444;\n            border-radius:8px;\n            font-size:14px;\n            font-weight:bold;\n        \">\n            flag{mixer_process_stopped}\n        </div>\n\n    </div>\n\n</div>\n\n\n<style>\n\n.mixer-running {\n    display:inline-block;\n    font-size:70px;\n    animation: mixer-spin 1.2s linear infinite;\n}\n\n.mixer-stopped {\n    display:inline-block;\n    font-size:70px;\n    opacity:0.45;\n}\n\n@keyframes mixer-spin {\n    from {\n        transform: rotate(0deg);\n    }\n\n    to {\n        transform: rotate(360deg);\n    }\n}\n\n</style>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 720,
        "y": 300,
        "wires": [
            []
        ]
